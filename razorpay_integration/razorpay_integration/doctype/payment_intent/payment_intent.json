{
  "doctype": "DocType",
  "name": "Payment Intent",
  "module": "Razorpay Integration",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "status",
    "provider",
    "provider_mode",
    "company",
    "request_type",
    "request_channel",
    "amount_requested",
    "amount_paid",
    "amount_allocated",
    "amount_unallocated",
    "currency",
    "allocation_status",
    "column_break_amounts",
    "reminder_count",
    "last_reminder_on",
    "request_source",
    "section_reference",
    "reference_doctype",
    "reference_name",
    "party_type",
    "party",
    "party_name",
    "party_email",
    "party_mobile",
    "lead",
    "patient",
    "encounter",
    "sales_order",
    "sales_invoice",
    "section_provider",
    "provider_request_id",
    "provider_link_id",
    "provider_order_id",
    "provider_payment_id",
    "provider_customer_id",
    "provider_terminal_id",
    "provider_pos_request_id",
    "pos_request_status",
    "pos_failure_reason",
    "payment_link_url",
    "payment_status",
    "provider_event_id",
    "section_timing",
    "requested_on",
    "paid_on",
    "expires_on",
    "last_synced_on",
    "section_audit",
    "requested_by",
    "sent_via",
    "notes",
    "provider_payload_snapshot"
  ],
  "fields": [
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nRequested\nPartially Paid\nPaid\nPartially Allocated\nAllocated\nExpired\nCancelled\nRefunded", "default": "Draft", "in_list_view": 1},
    {"fieldname": "provider", "fieldtype": "Data", "label": "Provider", "default": "Razorpay", "in_list_view": 1},
    {"fieldname": "provider_mode", "fieldtype": "Select", "label": "Provider Mode", "options": "Test\nLive", "default": "Test"},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company"},
    {"fieldname": "request_type", "fieldtype": "Select", "label": "Request Type", "options": "Advance\nAgainst Invoice", "default": "Advance", "in_list_view": 1},
    {"fieldname": "request_channel", "fieldtype": "Select", "label": "Request Channel", "options": "Payment Link\nCheckout\nManual Share\nPOS", "default": "Payment Link"},
    {"fieldname": "amount_requested", "fieldtype": "Currency", "label": "Amount Requested", "reqd": 1, "in_list_view": 1},
    {"fieldname": "amount_paid", "fieldtype": "Currency", "label": "Amount Paid", "default": 0},
    {"fieldname": "amount_allocated", "fieldtype": "Currency", "label": "Amount Allocated", "default": 0},
    {"fieldname": "amount_unallocated", "fieldtype": "Currency", "label": "Amount Unallocated", "default": 0},
    {"fieldname": "currency", "fieldtype": "Data", "label": "Currency", "default": "INR"},
    {"fieldname": "allocation_status", "fieldtype": "Data", "label": "Allocation Status"},
    {"fieldname": "column_break_amounts", "fieldtype": "Column Break"},
    {"fieldname": "reminder_count", "fieldtype": "Int", "label": "Reminder Count", "default": 0},
    {"fieldname": "last_reminder_on", "fieldtype": "Datetime", "label": "Last Reminder On"},
    {"fieldname": "request_source", "fieldtype": "Data", "label": "Request Source"},

    {"fieldname": "section_reference", "fieldtype": "Section Break", "label": "Reference Context"},
    {"fieldname": "reference_doctype", "fieldtype": "Data", "label": "Reference Doctype", "reqd": 1, "in_list_view": 1},
    {"fieldname": "reference_name", "fieldtype": "Data", "label": "Reference Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "party_type", "fieldtype": "Data", "label": "Party Type"},
    {"fieldname": "party", "fieldtype": "Data", "label": "Party"},
    {"fieldname": "party_name", "fieldtype": "Data", "label": "Party Name"},
    {"fieldname": "party_email", "fieldtype": "Data", "label": "Party Email"},
    {"fieldname": "party_mobile", "fieldtype": "Data", "label": "Party Mobile"},
    {"fieldname": "lead", "fieldtype": "Link", "label": "Lead", "options": "Lead"},
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient"},
    {"fieldname": "encounter", "fieldtype": "Link", "label": "Patient Encounter", "options": "Patient Encounter"},
    {"fieldname": "sales_order", "fieldtype": "Link", "label": "Sales Order", "options": "Sales Order"},
    {"fieldname": "sales_invoice", "fieldtype": "Link", "label": "Sales Invoice", "options": "Sales Invoice"},

    {"fieldname": "section_provider", "fieldtype": "Section Break", "label": "Provider Objects"},
    {"fieldname": "provider_request_id", "fieldtype": "Data", "label": "Provider Request ID"},
    {"fieldname": "provider_link_id", "fieldtype": "Data", "label": "Provider Payment Link ID"},
    {"fieldname": "provider_order_id", "fieldtype": "Data", "label": "Provider Order ID"},
    {"fieldname": "provider_payment_id", "fieldtype": "Data", "label": "Provider Payment ID"},
    {"fieldname": "provider_customer_id", "fieldtype": "Data", "label": "Provider Customer ID"},
    {"fieldname": "provider_terminal_id", "fieldtype": "Data", "label": "Provider Terminal ID"},
    {"fieldname": "provider_pos_request_id", "fieldtype": "Data", "label": "Provider POS Request ID"},
    {"fieldname": "pos_request_status", "fieldtype": "Data", "label": "POS Request Status"},
    {"fieldname": "pos_failure_reason", "fieldtype": "Small Text", "label": "POS Failure Reason"},
    {"fieldname": "payment_link_url", "fieldtype": "Data", "label": "Payment Link URL"},
    {"fieldname": "payment_status", "fieldtype": "Data", "label": "Payment Status"},
    {"fieldname": "provider_event_id", "fieldtype": "Data", "label": "Provider Event ID"},

    {"fieldname": "section_timing", "fieldtype": "Section Break", "label": "Timing"},
    {"fieldname": "requested_on", "fieldtype": "Datetime", "label": "Requested On"},
    {"fieldname": "paid_on", "fieldtype": "Datetime", "label": "Paid On"},
    {"fieldname": "expires_on", "fieldtype": "Datetime", "label": "Expires On"},
    {"fieldname": "last_synced_on", "fieldtype": "Datetime", "label": "Last Synced On"},

    {"fieldname": "section_audit", "fieldtype": "Section Break", "label": "Audit & Notes"},
    {"fieldname": "requested_by", "fieldtype": "Link", "label": "Requested By", "options": "User"},
    {"fieldname": "sent_via", "fieldtype": "Select", "label": "Sent Via", "options": "WhatsApp\nSMS\nEmail\nManual Copy\nOther"},
    {"fieldname": "notes", "fieldtype": "Long Text", "label": "Notes"},
    {"fieldname": "provider_payload_snapshot", "fieldtype": "Long Text", "label": "Provider Payload Snapshot"}
  ],
  "permissions": []
}
