  "fields": [
    {"fieldname": "section_provider", "fieldtype": "Section Break", "label": "Provider Configuration"},
    {"fieldname": "provider_enabled", "fieldtype": "Check", "label": "Enable Payment Provider", "default": 1},
    {"fieldname": "provider_mode", "fieldtype": "Select", "label": "Provider Mode", "options": "Test\nLive", "default": "Test"},
    {"fieldname": "provider_name", "fieldtype": "Data", "label": "Provider Name", "default": "Pine Labs", "read_only": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Default Company", "options": "Company"},
    {"fieldname": "payment_gateway_label", "fieldtype": "Data", "label": "Payment Gateway Label", "default": "Razorpay Payments"},
    {"fieldname": "column_break_provider_1", "fieldtype": "Column Break"},
    {"fieldname": "key_id", "fieldtype": "Data", "label": "API Key ID"},
    {"fieldname": "key_secret", "fieldtype": "Password", "label": "API Key Secret"},
    {"fieldname": "webhook_secret", "fieldtype": "Password", "label": "Webhook Secret"},
    {"fieldname": "api_base_url", "fieldtype": "Data", "label": "API Base URL", "default": "https://api.razorpay.com/v1"},

    {"fieldname": "pinelabs_credentials_sb", "fieldtype": "Section Break", "label": "Pine Labs Cloud Credentials"},
    {"fieldname": "pinelabs_merchant_id", "fieldtype": "Data", "label": "Merchant ID"},
    {"fieldname": "pinelabs_security_token", "fieldtype": "Password", "label": "Security Token"},
    {"fieldname": "pinelabs_store_id", "fieldtype": "Data", "label": "Store ID"},
    {"fieldname": "pinelabs_client_id", "fieldtype": "Data", "label": "Pine Labs Client ID"},
    {"fieldname": "pinelabs_user_id", "fieldtype": "Data", "label": "User ID"},
    {"fieldname": "pinelabs_allowed_payment_mode", "fieldtype": "Data", "label": "Allowed Payment Mode", "default": "0"},
    {"fieldname": "pinelabs_auto_cancel_duration", "fieldtype": "Int", "label": "Auto Cancel Duration In Minutes", "default": 5},
    {"fieldname": "pinelabs_endpoint_sb", "fieldtype": "Section Break", "label": "Pine Labs Cloud Endpoints"},
    {"fieldname": "pinelabs_base_url", "fieldtype": "Data", "label": "Base URL", "default": "https://www.plutuscloudserviceuat.in:8201"},
    {"fieldname": "pinelabs_upload_path", "fieldtype": "Data", "label": "Upload Transaction Path", "default": "/API/CloudBasedIntegration/V1/UploadBilledTransaction"},
    {"fieldname": "pinelabs_status_path", "fieldtype": "Data", "label": "Get Status Path", "default": "/API/CloudBasedIntegration/V1/GetCloudBasedTxnStatus"},
    {"fieldname": "pinelabs_cancel_path", "fieldtype": "Data", "label": "Cancel Transaction Path", "default": "/API/CloudBasedIntegration/V1/CancelTransaction"},

    {"fieldname": "section_feature_flags", "fieldtype": "Section Break", "label": "Feature Flags"},
    {"fieldname": "enable_payment_links", "fieldtype": "Check", "label": "Enable Payment Links", "default": 1},
    {"fieldname": "enable_order_checkout", "fieldtype": "Check", "label": "Enable Order Checkout"},
    {"fieldname": "enable_refunds", "fieldtype": "Check", "label": "Enable Refunds", "default": 1},
    {"fieldname": "enable_pos_payments", "fieldtype": "Check", "label": "Enable POS Payments"},
    {"fieldname": "enable_webhook_processing", "fieldtype": "Check", "label": "Enable Webhook Processing", "default": 1},
    {"fieldname": "enable_auto_allocation", "fieldtype": "Check", "label": "Enable Auto Allocation", "default": 1},
    {"fieldname": "enable_settlement_sync", "fieldtype": "Check", "label": "Enable Settlement Sync"},
    {"fieldname": "enable_payment_summary_sync", "fieldtype": "Check", "label": "Enable Payment Summary Sync", "default": 1},
    {"fieldname": "column_break_feature_1", "fieldtype": "Column Break"},
    {"fieldname": "default_request_channel", "fieldtype": "Select", "label": "Default Request Channel", "options": "Payment Link\nCheckout\nManual Share", "default": "Payment Link"},
    {"fieldname": "default_currency", "fieldtype": "Data", "label": "Default Currency", "default": "INR"},
    {"fieldname": "payment_link_expiry_hours", "fieldtype": "Int", "label": "Payment Link Expiry (Hours)", "default": 72},
    {"fieldname": "payment_link_reminder_hours", "fieldtype": "Int", "label": "Reminder Interval (Hours)", "default": 24},
    {"fieldname": "auto_allocate_encounter_advances", "fieldtype": "Check", "label": "Auto Allocate Encounter Advances", "default": 1},
    {"fieldname": "auto_allocate_sales_order_advances", "fieldtype": "Check", "label": "Auto Allocate Sales Order Advances", "default": 1},
    {"fieldname": "auto_bind_invoice_payments", "fieldtype": "Check", "label": "Auto Bind Invoice Payments", "default": 1},

    {"fieldname": "section_pos", "fieldtype": "Section Break", "label": "POS Terminal Payments"},
    {"fieldname": "default_pos_device_id", "fieldtype": "Data", "label": "Default POS Device / Client ID", "description": "This POS device is used automatically for POS payment requests when no device is selected on the transaction."},
    {"fieldname": "pos_api_base_url", "fieldtype": "Data", "label": "POS API Base URL"},
    {"fieldname": "pos_create_request_path", "fieldtype": "Data", "label": "POS Create Request Path", "default": "/pos/payment_requests"},
    {"fieldname": "pos_fetch_request_path", "fieldtype": "Data", "label": "POS Fetch Request Path", "default": "/pos/payment_requests/{request_id}"},
    {"fieldname": "pos_timeout_seconds", "fieldtype": "Int", "label": "POS API Timeout Seconds", "default": 30},
    {"fieldname": "pos_mode_of_payment", "fieldtype": "Data", "label": "POS Mode of Payment", "default": "Pine Labs POS"},

    {"fieldname": "section_doctype_controls", "fieldtype": "Section Break", "label": "Doctype-Level Controls"},
    {"fieldname": "enable_on_lead", "fieldtype": "Check", "label": "Enable on Lead", "default": 1},
    {"fieldname": "lead_default_request_type", "fieldtype": "Select", "label": "Lead Default Request Type", "options": "Advance\nAgainst Invoice", "default": "Advance"},
    {"fieldname": "lead_allow_partial_payment", "fieldtype": "Check", "label": "Lead: Allow Partial Payment", "default": 1},
    {"fieldname": "lead_auto_create_customer", "fieldtype": "Check", "label": "Lead: Auto Create Customer on Payment", "default": 1},
    {"fieldname": "column_break_doctype_1", "fieldtype": "Column Break"},
    {"fieldname": "enable_on_patient_encounter", "fieldtype": "Check", "label": "Enable on Patient Encounter", "default": 1},
    {"fieldname": "encounter_default_request_type", "fieldtype": "Select", "label": "Encounter Default Request Type", "options": "Advance\nAgainst Invoice", "default": "Advance"},
    {"fieldname": "encounter_allow_partial_payment", "fieldtype": "Check", "label": "Encounter: Allow Partial Payment", "default": 1},
    {"fieldname": "encounter_auto_allocate_to_invoice", "fieldtype": "Check", "label": "Encounter: Auto Allocate to Invoice", "default": 1},
    {"fieldname": "column_break_doctype_2", "fieldtype": "Column Break"},
    {"fieldname": "enable_on_sales_order", "fieldtype": "Check", "label": "Enable on Sales Order", "default": 1},
    {"fieldname": "sales_order_default_request_type", "fieldtype": "Select", "label": "Sales Order Default Request Type", "options": "Advance\nAgainst Invoice", "default": "Advance"},
    {"fieldname": "sales_order_allow_partial_payment", "fieldtype": "Check", "label": "Sales Order: Allow Partial Payment", "default": 1},
    {"fieldname": "sales_order_auto_allocate_to_invoice", "fieldtype": "Check", "label": "Sales Order: Auto Allocate to Invoice", "default": 1},
    {"fieldname": "column_break_doctype_3", "fieldtype": "Column Break"},
    {"fieldname": "enable_on_sales_invoice", "fieldtype": "Check", "label": "Enable on Sales Invoice", "default": 1},
    {"fieldname": "sales_invoice_default_request_type", "fieldtype": "Select", "label": "Sales Invoice Default Request Type", "options": "Against Invoice\nAdvance", "default": "Against Invoice"},
    {"fieldname": "sales_invoice_allow_partial_payment", "fieldtype": "Check", "label": "Sales Invoice: Allow Partial Payment", "default": 1},
    {"fieldname": "sales_invoice_auto_capture_against_invoice", "fieldtype": "Check", "label": "Sales Invoice: Auto Capture Against Invoice", "default": 1},

    {"fieldname": "section_behavior", "fieldtype": "Section Break", "label": "Allocation & Accounting Behavior"},
    {"fieldname": "allow_overpayment", "fieldtype": "Check", "label": "Allow Overpayment"},
    {"fieldname": "create_unallocated_credit_for_excess", "fieldtype": "Check", "label": "Create Unallocated Credit for Excess", "default": 1},
    {"fieldname": "auto_create_payment_entry_on_success", "fieldtype": "Check", "label": "Auto Create Payment Entry on Success", "default": 1},
    {"fieldname": "auto_submit_payment_entry", "fieldtype": "Check", "label": "Auto Submit Payment Entry", "default": 1},
    {"fieldname": "auto_mark_reference_paid_when_fully_allocated", "fieldtype": "Check", "label": "Auto Mark Reference Paid When Fully Allocated", "default": 1},
    {"fieldname": "column_break_behavior_1", "fieldtype": "Column Break"},
    {"fieldname": "default_advance_account", "fieldtype": "Link", "label": "Default Advance Account", "options": "Account"},
    {"fieldname": "default_receivable_account", "fieldtype": "Link", "label": "Default Receivable Account", "options": "Account"},
    {"fieldname": "default_cost_center", "fieldtype": "Link", "label": "Default Cost Center", "options": "Cost Center"},
    {"fieldname": "default_mode_of_payment", "fieldtype": "Data", "label": "Default Mode of Payment", "default": "Razorpay"},

    {"fieldname": "section_ui", "fieldtype": "Section Break", "label": "UI & Action Controls"},
    {"fieldname": "show_action_buttons", "fieldtype": "Check", "label": "Show Action Buttons on Reference Doctypes", "default": 1},
    {"fieldname": "show_payment_summary_on_reference_doctypes", "fieldtype": "Check", "label": "Show Payment Summary on Reference Doctypes", "default": 1},
    {"fieldname": "allow_manual_regenerate_payment_link", "fieldtype": "Check", "label": "Allow Manual Regenerate Payment Link", "default": 1},
    {"fieldname": "show_provider_debug_info", "fieldtype": "Check", "label": "Show Provider Debug Info"},

    {"fieldname": "section_security", "fieldtype": "Section Break", "label": "Security & Reliability"},
    {"fieldname": "mask_provider_payloads_in_ui", "fieldtype": "Check", "label": "Mask Provider Payloads in UI", "default": 1},
    {"fieldname": "store_full_webhook_payload", "fieldtype": "Check", "label": "Store Full Webhook Payload", "default": 1},
    {"fieldname": "enable_duplicate_webhook_guard", "fieldtype": "Check", "label": "Enable Duplicate Webhook Guard", "default": 1},

    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Internal Notes"},
    {"fieldname": "internal_notes", "fieldtype": "Long Text", "label": "Internal Notes"}
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
