{
  "doctype": "DocType",
  "name": "Payment Intent",
  "module": "Payment Orchestrator",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "overview_tab",
    "status",
    "gateway",
    "payment_mode",
    "provider_mode",
    "overview_column_break",
    "company",
    "request_type",
    "request_channel",
    "currency",
    "amounts_tab",
    "amount_requested",
    "amount_paid",
    "amounts_column_break",
    "amount_allocated",
    "amount_unallocated",
    "allocation_status",
    "reference_tab",
    "reference_doctype",
    "reference_name",
    "party_type",
    "party",
    "party_name",
    "reference_column_break",
    "party_email",
    "party_mobile",
    "lead",
    "patient",
    "encounter",
    "sales_order",
    "sales_invoice",
    "payment_entry",
    "provider_tab",
    "provider",
    "provider_request_id",
    "provider_link_id",
    "provider_qr_id",
    "provider_order_id",
    "provider_payment_id",
    "provider_column_break",
    "provider_customer_id",
    "provider_terminal_id",
    "provider_pos_request_id",
    "pos_payment_method",
    "pos_allowed_payment_mode",
    "provider_event_id",
    "payment_status",
    "artifacts_tab",
    "payment_link_url",
    "qr_code_url",
    "qr_status",
    "qr_close_by",
    "artifacts_column_break",
    "pos_request_status",
    "pos_failure_reason",
    "timeline_tab",
    "requested_on",
    "paid_on",
    "expires_on",
    "last_synced_on",
    "timeline_column_break",
    "reminder_count",
    "last_reminder_on",
    "audit_tab",
    "requested_by",
    "request_source",
    "sent_via",
    "audit_column_break",
    "whatsapp_audit_section",
    "last_whatsapp_sent_on",
    "last_whatsapp_recipient",
    "last_whatsapp_channel_account",
    "last_whatsapp_message",
    "whatsapp_audit_column_break",
    "last_whatsapp_content_type",
    "whatsapp_send_status",
    "last_whatsapp_error",
    "notes",
    "provider_payload_snapshot"
  ],
    "fields": [
    {"fieldname": "overview_tab", "fieldtype": "Tab Break", "label": "Overview"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nRequested\nPartially Paid\nPaid\nPartially Allocated\nAllocated\nExpired\nCancelled\nRefunded", "default": "Draft", "in_list_view": 1},
    {"fieldname": "gateway", "fieldtype": "Select", "label": "Gateway", "options": "Razorpay\nPine Labs", "in_list_view": 1},
    {"fieldname": "payment_mode", "fieldtype": "Select", "label": "Payment Mode", "options": "Payment Link\nQR Code\nPOS\nCheckout\nManual Share", "in_list_view": 1},
    {"fieldname": "provider", "fieldtype": "Data", "label": "Provider", "default": "Razorpay", "in_list_view": 1},
    {"fieldname": "provider_mode", "fieldtype": "Select", "label": "Provider Mode", "options": "Test\nLive", "default": "Test"},
    {"fieldname": "overview_column_break", "fieldtype": "Column Break"},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company"},
    {"fieldname": "request_type", "fieldtype": "Select", "label": "Request Type", "options": "Advance\nAgainst Invoice", "default": "Advance", "in_list_view": 1},
    {"fieldname": "request_channel", "fieldtype": "Select", "label": "Request Channel", "options": "Payment Link\nQR Code\nCheckout\nManual Share\nPOS", "default": "Payment Link"},
    {"fieldname": "amounts_tab", "fieldtype": "Tab Break", "label": "Amounts"},
    {"fieldname": "amount_requested", "fieldtype": "Currency", "label": "Amount Requested", "reqd": 1, "in_list_view": 1},
    {"fieldname": "amount_paid", "fieldtype": "Currency", "label": "Amount Paid", "default": 0},
    {"fieldname": "amounts_column_break", "fieldtype": "Column Break"},
    {"fieldname": "amount_allocated", "fieldtype": "Currency", "label": "Amount Allocated", "default": 0},
    {"fieldname": "amount_unallocated", "fieldtype": "Currency", "label": "Amount Unallocated", "default": 0},
    {"fieldname": "currency", "fieldtype": "Data", "label": "Currency", "default": "INR"},
    {"fieldname": "allocation_status", "fieldtype": "Data", "label": "Allocation Status"},
    {"fieldname": "reminder_count", "fieldtype": "Int", "label": "Reminder Count", "default": 0},
    {"fieldname": "last_reminder_on", "fieldtype": "Datetime", "label": "Last Reminder On"},
    {"fieldname": "request_source", "fieldtype": "Data", "label": "Request Source"},

    {"fieldname": "reference_tab", "fieldtype": "Tab Break", "label": "Reference"},
    {"fieldname": "reference_doctype", "fieldtype": "Data", "label": "Reference Doctype", "reqd": 1, "in_list_view": 1},
    {"fieldname": "reference_name", "fieldtype": "Data", "label": "Reference Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "party_type", "fieldtype": "Data", "label": "Party Type"},
    {"fieldname": "party", "fieldtype": "Data", "label": "Party"},
    {"fieldname": "party_name", "fieldtype": "Data", "label": "Party Name"},
    {"fieldname": "reference_column_break", "fieldtype": "Column Break"},
    {"fieldname": "party_email", "fieldtype": "Data", "label": "Party Email"},
    {"fieldname": "party_mobile", "fieldtype": "Data", "label": "Party Mobile"},
    {"fieldname": "lead", "fieldtype": "Link", "label": "Lead", "options": "Lead"},
    {"fieldname": "patient", "fieldtype": "Link", "label": "Patient", "options": "Patient"},
    {"fieldname": "encounter", "fieldtype": "Link", "label": "Patient Encounter", "options": "Patient Encounter"},
    {"fieldname": "sales_order", "fieldtype": "Link", "label": "Sales Order", "options": "Sales Order"},
    {"fieldname": "sales_invoice", "fieldtype": "Link", "label": "Sales Invoice", "options": "Sales Invoice"},
    {"fieldname": "payment_entry", "fieldtype": "Link", "label": "Payment Entry", "options": "Payment Entry"},

    {"fieldname": "provider_tab", "fieldtype": "Tab Break", "label": "Provider"},
    {"fieldname": "provider_request_id", "fieldtype": "Data", "label": "Provider Request ID"},
    {"fieldname": "provider_link_id", "fieldtype": "Data", "label": "Provider Payment Link ID"},
    {"fieldname": "provider_qr_id", "fieldtype": "Data", "label": "Provider QR Code ID"},
    {"fieldname": "provider_order_id", "fieldtype": "Data", "label": "Provider Order ID"},
    {"fieldname": "provider_payment_id", "fieldtype": "Data", "label": "Provider Payment ID"},
    {"fieldname": "provider_column_break", "fieldtype": "Column Break"},
    {"fieldname": "provider_customer_id", "fieldtype": "Data", "label": "Provider Customer ID"},
    {"fieldname": "provider_terminal_id", "fieldtype": "Data", "label": "Provider Terminal ID"},
    {"fieldname": "provider_pos_request_id", "fieldtype": "Data", "label": "Provider POS Request ID"},
    {"fieldname": "pos_payment_method", "fieldtype": "Data", "label": "POS Payment Method", "in_list_view": 1},
    {"fieldname": "pos_allowed_payment_mode", "fieldtype": "Data", "label": "POS Allowed Payment Mode Code"},
    {"fieldname": "pos_request_status", "fieldtype": "Data", "label": "POS Request Status"},
    {"fieldname": "pos_failure_reason", "fieldtype": "Small Text", "label": "POS Failure Reason"},
    {"fieldname": "payment_link_url", "fieldtype": "Data", "label": "Payment Link URL"},
    {"fieldname": "qr_code_url", "fieldtype": "Data", "label": "QR Code URL"},
    {"fieldname": "qr_status", "fieldtype": "Data", "label": "QR Status"},
    {"fieldname": "qr_close_by", "fieldtype": "Int", "label": "QR Close By"},
    {"fieldname": "payment_status", "fieldtype": "Data", "label": "Payment Status"},
    {"fieldname": "provider_event_id", "fieldtype": "Data", "label": "Provider Event ID"},

    {"fieldname": "artifacts_tab", "fieldtype": "Tab Break", "label": "Artifacts"},
    {"fieldname": "artifacts_column_break", "fieldtype": "Column Break"},
    {"fieldname": "timeline_tab", "fieldtype": "Tab Break", "label": "Timeline"},
    {"fieldname": "requested_on", "fieldtype": "Datetime", "label": "Requested On"},
    {"fieldname": "paid_on", "fieldtype": "Datetime", "label": "Paid On"},
    {"fieldname": "expires_on", "fieldtype": "Datetime", "label": "Expires On"},
    {"fieldname": "last_synced_on", "fieldtype": "Datetime", "label": "Last Synced On"},
    {"fieldname": "timeline_column_break", "fieldtype": "Column Break"},

    {"fieldname": "audit_tab", "fieldtype": "Tab Break", "label": "Audit"},
    {"fieldname": "requested_by", "fieldtype": "Link", "label": "Requested By", "options": "User"},
    {"fieldname": "sent_via", "fieldtype": "Select", "label": "Sent Via", "options": "WhatsApp\nSMS\nEmail\nManual Copy\nOther"},
    {"fieldname": "audit_column_break", "fieldtype": "Column Break"},
    {"fieldname": "whatsapp_audit_section", "fieldtype": "Section Break", "label": "WhatsApp Audit"},
    {"fieldname": "last_whatsapp_sent_on", "fieldtype": "Datetime", "label": "Last WhatsApp Sent On", "read_only": 1},
    {"fieldname": "last_whatsapp_recipient", "fieldtype": "Data", "label": "Last WhatsApp Recipient", "read_only": 1},
    {"fieldname": "last_whatsapp_channel_account", "fieldtype": "Data", "label": "Last WhatsApp Channel Account", "read_only": 1},
    {"fieldname": "last_whatsapp_message", "fieldtype": "Data", "label": "Last WhatsApp Message", "read_only": 1},
    {"fieldname": "whatsapp_audit_column_break", "fieldtype": "Column Break"},
    {"fieldname": "last_whatsapp_content_type", "fieldtype": "Data", "label": "Last WhatsApp Content Type", "read_only": 1},
    {"fieldname": "whatsapp_send_status", "fieldtype": "Data", "label": "WhatsApp Send Status", "read_only": 1},
    {"fieldname": "last_whatsapp_error", "fieldtype": "Small Text", "label": "Last WhatsApp Error", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Long Text", "label": "Notes"},
    {"fieldname": "provider_payload_snapshot", "fieldtype": "Long Text", "label": "Provider Payload Snapshot"}
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
