    {"fieldname": "pinelabs_pos_mode", "fieldtype": "Select", "label": "Pine Labs Environment", "options": "Test\nLive", "default": "Test"},
    {"fieldname": "pinelabs_postback_sb", "fieldtype": "Section Break", "label": "Pine Labs Postback"},
    {"fieldname": "enable_pinelabs_postback_processing", "fieldtype": "Check", "label": "Enable Pine Labs Postback Processing", "default": 1},
    {"fieldname": "enable_pinelabs", "fieldtype": "Check", "label": "Enable Pine Labs", "default": 1},
    {"fieldname": "pinelabs_merchant_id", "fieldtype": "Data", "label": "Merchant ID / MID", "description": "Merchant ID provided by Pine Labs, for example MID."},
    {"fieldname": "pinelabs_merchant_name", "fieldtype": "Data", "label": "Merchant Name", "description": "Display/reference only. Not sent to Pine Labs POS APIs."},
    {"fieldname": "pinelabs_security_token", "fieldtype": "Password", "label": "Security Token No", "description": "Security token provided by Pine Labs for Plutus Cloud POS APIs."},
    {"fieldname": "pinelabs_store_id", "fieldtype": "Data", "label": "Store ID", "description": "Store ID provided by Pine Labs."},
    {"fieldname": "pinelabs_store_name", "fieldtype": "Data", "label": "Store Name", "description": "Display/reference only. Not sent to Pine Labs POS APIs."},
    {"fieldname": "pinelabs_client_id", "fieldtype": "Data", "label": "POS ID / Client ID", "description": "Pine Labs POS ID used as ClientId in Plutus Cloud POS requests."},
    {"fieldname": "pinelabs_device_no", "fieldtype": "Data", "label": "Device No", "description": "Pine Labs device number for reference. Not sent as ClientId unless Pine Labs specifically asks for it."},
    {"fieldname": "pinelabs_user_id", "fieldtype": "Data", "label": "Pine Labs User ID", "description": "Optional. If blank, current ERP user is sent as UserID."},
    {"fieldname": "pinelabs_allowed_payment_mode", "fieldtype": "Data", "label": "Allowed Payment Mode Code", "default": "0", "description": "Default Pine Labs AllowedPaymentMode code. Used for All Modes."},
    {"fieldname": "pinelabs_card_payment_mode_code", "fieldtype": "Data", "label": "Card Payment Mode Code", "description": "Pine Labs AllowedPaymentMode code for card-only POS requests. Confirm this value with Pine Labs."},
    {"fieldname": "pinelabs_upi_qr_payment_mode_code", "fieldtype": "Data", "label": "UPI / QR Payment Mode Code", "default": "10", "description": "Pine Labs AllowedPaymentMode code for UPI / QR POS requests. Confirm this value with Pine Labs."},
    {"fieldname": "pinelabs_auto_cancel_duration", "fieldtype": "Int", "label": "Auto Cancel Duration In Minutes", "default": 5},
