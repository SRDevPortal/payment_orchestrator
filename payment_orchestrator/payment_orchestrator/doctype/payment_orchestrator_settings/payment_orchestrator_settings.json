    {"fieldname": "pinelabs_upload_path", "fieldtype": "Data", "label": "Upload Transaction Path", "default": "/API/CloudBasedIntegration/V1/UploadBilledTransaction"},
    {"fieldname": "pinelabs_status_path", "fieldtype": "Data", "label": "Get Status Path", "default": "/API/CloudBasedIntegration/V1/GetCloudBasedTxnStatus"},
    {"fieldname": "pinelabs_cancel_path", "fieldtype": "Data", "label": "Cancel Transaction Path", "default": "/API/CloudBasedIntegration/V1/CancelTransaction"},
    {"fieldname": "pinelabs_online_client_id", "fieldtype": "Data", "label": "Online Client ID"},
    {"fieldname": "pinelabs_online_client_secret", "fieldtype": "Password", "label": "Online Client Secret"},
    {"fieldname": "pinelabs_online_base_url", "fieldtype": "Data", "label": "Online Base URL", "default": "https://pluraluat.v2.pinepg.in"},
    {"fieldname": "pinelabs_online_auth_path", "fieldtype": "Data", "label": "Auth Token Path", "default": "/api/auth/v1/token"},
    {"fieldname": "pinelabs_payment_link_path", "fieldtype": "Data", "label": "Payment Link Path", "default": "/api/pay/v1/paymentlink"},
    {"fieldname": "pinelabs_payment_link_allowed_methods", "fieldtype": "Data", "label": "Allowed Payment Methods", "default": "CARD,UPI", "description": "Comma-separated Pine Labs method codes, for example CARD,UPI."},
    {"fieldname": "pinelabs_payment_link_callback_url", "fieldtype": "Data", "label": "Payment Link Callback URL"},
    {"fieldname": "pinelabs_payment_link_failure_callback_url", "fieldtype": "Data", "label": "Payment Link Failure Callback URL"},

