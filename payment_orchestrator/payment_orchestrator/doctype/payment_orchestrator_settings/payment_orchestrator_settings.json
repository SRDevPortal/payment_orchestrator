    {"fieldname": "pinelabs_payment_link_mode", "fieldtype": "Select", "label": "Pine Labs Payment Link Mode", "options": "Test\nLive", "default": "Test"},
    {"fieldname": "pinelabs_payment_link_after_payment_display", "fieldtype": "Select", "label": "After Payment Display", "options": "Pine Labs Default Page\nPayment Orchestrator Page", "default": "Pine Labs Default Page", "description": "Choose what the customer sees after completing a Pine Labs payment link. Pine Labs Default Page omits callback URLs from the payment link request and relies on status sync for ERP updates."},
    {"fieldname": "pinelabs_payment_link_sb", "fieldtype": "Section Break", "label": "Pine Labs Payment Link"},
    {"fieldname": "pinelabs_pos_sb", "fieldtype": "Section Break", "label": "Pine Labs POS / Plutus Cloud"},
